{
  "name": "lokal",
  "version": "0.1.0",
  "private": true,
  "description": "Your local LLM, hired and paid on Cardano (Sokosumi + Masumi), set up from one terminal.",
  "type": "module",
  "bin": {
    "lokal": "bin/lokal.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node bin/lokal.mjs",
    "mock": "node bin/lokal.mjs --mock",
    "test": "node --test test/*.test.mjs",
    "test:all": "node --test test/*.test.mjs && cd coworker && npm test",
    "smoke": "sh scripts/smoke.sh"
  },
  "dependencies": {
    "htm": "3.1.1",
    "ink": "8.0.0",
    "qrcode": "1.5.4",
    "react": "19.3.1"
  }
}
